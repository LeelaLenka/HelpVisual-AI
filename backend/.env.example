# HelpVisual AI runs every model on its own ML server: the Kaggle notebook
# (kaggle/helpvisual_ml_server.ipynb). Start it, then paste the lines it prints here.
# Optionally, Gemini (free tier) can paint the pictures too; see the Gemini section below.

# Images and image checks (Stable Diffusion XL, ControlNet, CLIP, EasyOCR)
ML_ENDPOINT_URL=
ML_ENDPOINT_TOKEN=

# Language model (Qwen2.5-7B-Instruct), reached in the OpenAI chat format
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# Optional: Gemini image generation (free tier, https://aistudio.google.com/apikey).
# The key stays here on the server and is never sent to the browser.
# IMAGE_MODE: auto (Gemini first, the Kaggle notebook when Gemini is unavailable), gemini, or kaggle.
# Checks (CLIP, OCR), the language model and translation still need the Kaggle notebook; without it,
# only the help-center card level can be made, and its pictures are marked "not checked".
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_MIN_INTERVAL=6
IMAGE_MODE=auto

# Image settings
IMAGE_WIDTH=1152
IMAGE_HEIGHT=896
SDXL_STEPS=30
SDXL_CANDIDATES=2
MAX_REPAIR_ATTEMPTS=2
PASS_SCORE=70
CLIP_MIN_SIMILARITY=0.19

# Accounts
SECRET_KEY=
COOKIE_SECURE=false
DEV_RESET_LINKS=true
